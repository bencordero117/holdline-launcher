<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>holdline.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Sound\track1.mp3" LogicalName="track1.mp3" />
    <EmbeddedResource Include="Sound\track2.mp3" LogicalName="track2.mp3" />
    <EmbeddedResource Include="Sound\track3.mp3" LogicalName="track3.mp3" />
  </ItemGroup>

</Project>