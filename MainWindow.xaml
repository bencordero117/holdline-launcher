<Window x:Class="HoldlineLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Holdline"
        Height="760" Width="1180"
        MinHeight="620" MinWidth="980"
        Background="#120D08"
        FontFamily="Segoe UI, Inter, Arial"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        Loaded="Shell_Loaded">

    <!--
        Holdline launcher shell. TWO SCREENS in one window:

            LandingView  - the door. Ride in, and the side tiles.
            BrowserView  - the hold list, search, and detail rail.

        Only one is visible at a time; Shell.cs flips them. They are not
        separate windows, because a second window would drop the music and
        throw away whatever size the player had just set.

        Every x:Name the join code reaches for exists here exactly once:
            DetailName DetailTagline DetailAddress DetailKey DetailRegion
            DetailAccess HoldCountText HoldList JoinButton MasterText
            StatusText RestoreButton
        Renaming any of them breaks the build. The newer ones - SearchBox,
        MuteButton, MuteGlyph, RefreshButton, PatreonButton, WebsiteButton,
        SettingsButton,
        RideInButton, BackButton, LandingView, BrowserView - are served by
        Shell.cs.
    -->

    <Window.Resources>

        <!-- ==================== palette ==================== -->
        <SolidColorBrush x:Key="Bg"        Color="#120D08"/>
        <SolidColorBrush x:Key="Panel"     Color="#2A2015"/>
        <SolidColorBrush x:Key="Card"      Color="#251C13"/>
        <SolidColorBrush x:Key="Line"      Color="#4A3A26"/>
        <SolidColorBrush x:Key="LineSoft"  Color="#6B5637"/>
        <SolidColorBrush x:Key="Accent"    Color="#D98A3D"/>
        <SolidColorBrush x:Key="AccentHi"  Color="#E9A057"/>
        <SolidColorBrush x:Key="Ink"       Color="#EDE2C9"/>
        <SolidColorBrush x:Key="Muted"     Color="#B0A08A"/>
        <SolidColorBrush x:Key="Dim"       Color="#8B7B63"/>

        <FontFamily x:Key="Display">Palatino Linotype, Book Antiqua, Georgia, serif</FontFamily>

        <!-- ==================== hold row ====================
             Slimmed from the first pass: crest 44 to 30, vertical padding 10
             to 6, tagline folded onto the name's line. A row is about 46px
             now instead of 74, so roughly eleven fit where six did. A server
             browser lives or dies on how many servers you see at once. -->
        <Style x:Key="HoldRowStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowRoot"
                                Background="{StaticResource Card}"
                                BorderBrush="{StaticResource Line}"
                                BorderThickness="1"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="EdgeMark"
                                        Width="3"
                                        HorizontalAlignment="Left"
                                        Background="Transparent"/>
                                <ContentPresenter Margin="11,6,12,6"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowRoot" Property="Background" Value="#2E2317"/>
                                <Setter TargetName="RowRoot" Property="BorderBrush" Value="{StaticResource LineSoft}"/>
                                <Setter TargetName="EdgeMark" Property="Background" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowRoot" Property="Background" Value="#33261A"/>
                                <Setter TargetName="RowRoot" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="EdgeMark" Property="Background" Value="{StaticResource AccentHi}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== chips ==================== -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="#1D1610"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="6,1,6,2"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- ==================== ghost button ==================== -->
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="GhostRoot"
                                Background="{StaticResource Card}"
                                BorderBrush="{StaticResource Line}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GhostRoot" Property="Background" Value="#33261A"/>
                                <Setter TargetName="GhostRoot" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== primary button ==================== -->
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Foreground" Value="#1A1208"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnRoot" CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#E9A057" Offset="0"/>
                                    <GradientStop Color="#C97B31" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnRoot" Property="Background" Value="#F2AF66"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnRoot" Property="Background" Value="#4A3A26"/>
                                <Setter Property="Foreground" Value="#8B7B63"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== chrome-less button ====================
             For the Ride in panel and the featured strip, which have to be
             clickable without looking like a button bolted on.

             The template is a Border rather than a bare ContentPresenter on
             purpose. A ContentPresenter alone has nothing to hit-test against,
             so clicks only register where a child happens to have drawn
             something - and in the featured strip, most of the bar is gap.
             A Border with a Transparent background is invisible but solid to
             the mouse. -->
        <Style x:Key="Bare" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BareRoot"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BareRoot" Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== search box ==================== -->
        <Style x:Key="Search" TargetType="TextBox">
            <Setter Property="Background" Value="#1D1610"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentHi}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,7,10,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ==================== detail fields ==================== -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- ==================== side tile ==================== -->
        <Style x:Key="SideTile" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Padding" Value="14,10,14,11"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- top bar, always on -->
            <RowDefinition Height="Auto"/>   <!-- promo strip, always on -->
            <RowDefinition Height="*"/>      <!-- one of the two screens -->
            <RowDefinition Height="Auto"/>   <!-- status, always on -->
        </Grid.RowDefinitions>

        <!-- ============================================================
             TOP BAR
             ============================================================ -->
        <Border Grid.Row="0" Background="#1A1309" Padding="22,14,22,12"
                BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="H O L D L I N E"
                               FontFamily="{StaticResource Display}"
                               FontSize="21"
                               Foreground="{StaticResource Ink}"/>
                    <Border Height="2" Margin="1,5,0,0"
                            HorizontalAlignment="Left" Width="164">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#E9A057" Offset="0"/>
                                <GradientStop Color="#D98A3D" Offset="0.55"/>
                                <GradientStop Color="#00D98A3D" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Text="master"
                               Style="{StaticResource ChipText}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="MasterText" Text="holdline"
                               FontSize="11"
                               Foreground="{StaticResource Muted}"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <Button x:Name="WebsiteButton"
                            Content="Website"
                            Style="{StaticResource Ghost}"
                            Padding="11,4,11,5" Margin="0,0,7,0"
                            ToolTip="Open the Holdline site in your web browser"
                            Click="WebsiteButton_Click"/>

                    <Button x:Name="SettingsButton"
                            Content="Settings"
                            Style="{StaticResource Ghost}"
                            Padding="11,4,11,5" Margin="0,0,7,0"
                            ToolTip="Game folder, Fix my game, and other options"
                            Click="SettingsButton_Click"/>

                    <Button x:Name="MuteButton"
                            Style="{StaticResource Ghost}"
                            Padding="9,4,9,5" Margin="0,0,7,0"
                            ToolTip="Mute or unmute the music"
                            Click="MuteButton_Click">
                        <!-- Fixed width because the label swaps between
                             "Sound on", "Sound off" and "No sound". Without
                             it the button resizes and shoves Refresh sideways
                             every time you click mute. -->
                        <TextBlock x:Name="MuteGlyph" Text="Sound on"
                                   FontSize="11"
                                   Width="54"
                                   TextAlignment="Center"/>
                    </Button>

                    <Button x:Name="RefreshButton"
                            Content="Refresh"
                            Style="{StaticResource Ghost}"
                            Padding="11,4,11,5"
                            ToolTip="Fetch the hold list again"
                            Click="RefreshButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================
             PROMO STRIP - sits above both screens, so it survives moving
             between the landing and the browser.

             Starts Collapsed and only appears once there is something real to
             show. An empty gold bar on every launch would look like a bug,
             and a bar reading "advertise here" would look like a business
             with no customers.
             ============================================================ -->
        <Border x:Name="PromoStrip"
                Grid.Row="1"
                Visibility="Collapsed"
                Background="#1F1710"
                BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1"
                Padding="0">
            <Button x:Name="PromoButton"
                    Style="{StaticResource Bare}"
                    ToolTip="Go to this hold"
                    Click="PromoButton_Click">
                <Grid Height="56">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Colour bar carrying the promoted hold's own accent, so
                         the strip changes character with each slide instead of
                         being a uniform gold band. -->
                    <Border x:Name="PromoAccent"
                            Grid.Column="0"
                            Width="5"
                            Background="{StaticResource Accent}"/>

                    <TextBlock Grid.Column="1"
                               Text="FEATURED"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{StaticResource Accent}"
                               VerticalAlignment="Center"
                               Margin="18,0,20,0"/>

                    <!-- The part that actually changes. Opacity is animated
                         from code for the crossfade; animating Opacity on an
                         element is always safe, unlike reaching into an
                         Effect. -->
                    <StackPanel x:Name="PromoContent"
                                Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="PromoName"
                                   Text=""
                                   FontFamily="{StaticResource Display}"
                                   FontSize="16"
                                   Foreground="{StaticResource Ink}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="PromoTagline"
                                   Text=""
                                   FontSize="11"
                                   Foreground="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   Margin="14,2,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Slide position. Filled in by Shell.cs, one small
                         square per promoted hold. -->
                    <StackPanel x:Name="PromoDots"
                                Grid.Column="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="18,0,22,0"/>
                </Grid>
            </Button>
        </Border>

        <!-- ============================================================
             SCREEN 1 - LANDING
             ============================================================ -->
        <Grid x:Name="LandingView" Grid.Row="2" Margin="22,22,22,0"
              Visibility="Visible">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="266"/>
            </Grid.ColumnDefinitions>

            <!-- The door. The whole panel is one button.

                 The ember pulse is a blurred layer behind it whose own
                 Opacity animates. Animating a property inside an Effect is
                 the obvious way to do this and it throws at runtime if WPF
                 has frozen the effect, which is not worth gambling a launch
                 on. Same look, no gamble. -->
            <Grid Grid.Column="0" VerticalAlignment="Top">

                <Border CornerRadius="10" Margin="-6" Opacity="0.14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF9A3C" Offset="0"/>
                            <GradientStop Color="#D98A3D" Offset="0.5"/>
                            <GradientStop Color="#7A4A18" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <BlurEffect Radius="30"/>
                    </Border.Effect>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Border.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="0.07" To="0.26"
                                                     Duration="0:0:3.6"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                </Border>

                <Button x:Name="RideInButton"
                        Style="{StaticResource Bare}"
                        ToolTip="See every hold"
                        Click="RideInButton_Click">
                    <Border Background="{StaticResource Panel}"
                            BorderBrush="{StaticResource Line}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="30,34,30,34">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="62" Height="62"
                                  Margin="0,0,22,0" VerticalAlignment="Center">
                                <Ellipse Stroke="{StaticResource Accent}"
                                         StrokeThickness="2" Fill="#1D1610"/>
                                <Path Data="M 0,0 L 18,11 L 0,22 Z"
                                      Fill="{StaticResource AccentHi}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="5,0,0,0"/>
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Ride in"
                                           FontFamily="{StaticResource Display}"
                                           FontSize="34"
                                           Foreground="{StaticResource Ink}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Browse "
                                               FontSize="13"
                                               Foreground="{StaticResource Muted}"/>
                                    <TextBlock x:Name="HoldCountText"
                                               Text="loading"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentHi}"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="&#x2192;"
                                       FontSize="30"
                                       Foreground="{StaticResource Accent}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Button>
            </Grid>

            <!-- Side tiles. Every one does something. -->
            <StackPanel Grid.Column="2">

                <!-- Always here, paid or not. Someone who has just enjoyed a
                     hold is the likeliest person to back it, and showing this
                     only to existing patrons would be backwards. -->
                <Button x:Name="PatreonButton"
                        Style="{StaticResource SideTile}"
                        ToolTip="Opens in your web browser"
                        Click="PatreonButton_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="8" Height="26"
                                CornerRadius="2" Margin="0,0,11,0"
                                VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#E9A057" Offset="0"/>
                                    <GradientStop Color="#B5432B" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Support on Patreon"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}"/>
                            <TextBlock Text="Founding a hold needs a membership"
                                       FontSize="10"
                                       Foreground="{StaticResource Dim}"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <Button x:Name="RestoreButton"
                        Style="{StaticResource SideTile}"
                        ToolTip="Put your single-player game back the way it was"
                        Click="RestoreButton_Click">
                    <StackPanel>
                        <TextBlock Text="Restore vanilla"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}"/>
                        <TextBlock Text="Undo Holdline's game files"
                                   FontSize="10"
                                   Foreground="{StaticResource Dim}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <Border Background="{StaticResource Card}"
                        BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="2"
                        Padding="14,10,14,11">
                    <StackPanel>
                        <TextBlock Text="First time here?"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}"/>
                        <TextBlock Text="Press Ride in, pick a hold, press Join. The launcher sets up everything it can on its own."
                                   FontSize="10"
                                   Foreground="{StaticResource Dim}"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ============================================================
             SCREEN 2 - BROWSER
             ============================================================ -->
        <Grid x:Name="BrowserView" Grid.Row="2" Margin="22,16,22,0"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- back + search -->
                <RowDefinition Height="Auto"/>   <!-- filter panel -->
                <RowDefinition Height="*"/>      <!-- list + detail -->
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="266"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton"
                        Content="&#x2190;  Back"
                        Style="{StaticResource Ghost}"
                        Padding="13,8,15,9"
                        Margin="0,0,10,0"
                        VerticalAlignment="Top"
                        ToolTip="Back to the front"
                        Click="BackButton_Click"/>

                <!-- WPF has no placeholder text of its own, so it is a label
                     behind the box that hides itself the moment there is
                     anything to hide behind. IsHitTestVisible false keeps
                     clicks landing in the box. -->
                <Grid Grid.Column="1">
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource Search}"
                             TextChanged="SearchBox_TextChanged"/>
                    <TextBlock Text="Search holds by name or tagline"
                               FontSize="13" Foreground="#7A6B55"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Filters toggle. The count in the label is written from
                     code so the button itself advertises how many filters are
                     narrowing the list - otherwise a filtered list looks like
                     a broken list. -->
                <Button x:Name="FiltersButton"
                        Grid.Column="3"
                        Content="Filters"
                        Style="{StaticResource Ghost}"
                        Padding="15,8,15,9"
                        VerticalAlignment="Top"
                        ToolTip="Narrow the holds down"
                        Click="FiltersButton_Click"/>

                <TextBlock Grid.Column="5" Text="THE HOLDS"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource Dim}"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- ==================== filter panel ====================
                 Collapsed until the Filters button is pressed, so the
                 browser stays clean for anyone who never wants it. Every
                 control here calls the same handler, which just refreshes
                 the view - the holds collection is never modified, so none
                 of the proven join logic is affected. -->
            <Border x:Name="FilterPanel"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Background="{StaticResource Card}"
                    BorderBrush="{StaticResource Line}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14,16,14"
                    Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="FILTER HOLDS"
                                   Style="{StaticResource FieldLabel}"
                                   HorizontalAlignment="Left"/>
                        <Button x:Name="ClearFiltersButton"
                                Content="Clear all"
                                Style="{StaticResource Bare}"
                                HorizontalAlignment="Right"
                                Foreground="#B5432B"
                                FontSize="12"
                                Click="ClearFiltersButton_Click"/>
                    </Grid>

                    <!-- Chips are built in code rather than listed here, so the
                         tag list only ever lives in one place. -->
                    <TextBlock Text="TAGS"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,0,0,7"/>
                    <WrapPanel x:Name="TagFilterPanel" Margin="0,0,0,16"/>

                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,26,0">
                            <TextBlock Text="LANGUAGE"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,0,0,5"/>
                            <ComboBox x:Name="LanguageFilterBox"
                                      Width="170"
                                      SelectionChanged="FilterBoxChanged"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,26,0">
                            <TextBlock Text="FRAMEWORK"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,0,0,5"/>
                            <ComboBox x:Name="FrameworkFilterBox"
                                      Width="200"
                                      SelectionChanged="FilterBoxChanged"/>
                        </StackPanel>

                        <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,3">
                            <CheckBox x:Name="HideEmptyCheck"
                                      Content="Hide empty holds"
                                      Foreground="{StaticResource Muted}"
                                      FontSize="13"
                                      Margin="0,0,0,7"
                                      Checked="FilterChanged"
                                      Unchecked="FilterChanged"/>
                            <CheckBox x:Name="HideFullCheck"
                                      Content="Hide full holds"
                                      Foreground="{StaticResource Muted}"
                                      FontSize="13"
                                      Checked="FilterChanged"
                                      Unchecked="FilterChanged"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock x:Name="FilterResultText"
                               Foreground="{StaticResource Dim}"
                               FontSize="12"
                               Margin="0,13,0,0"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="266"/>
                </Grid.ColumnDefinitions>

                <ListBox x:Name="HoldList"
                         Grid.Column="0"
                         Background="Transparent"
                         BorderThickness="0" Padding="0"
                         ItemContainerStyle="{StaticResource HoldRowStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="HoldList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Crest. No artwork exists yet, so the
                                     hold's own accent colour stands in rather
                                     than a grey box pretending a thumbnail is
                                     on the way. -->
                                <Border Grid.Column="0"
                                        Width="30" Height="30"
                                        CornerRadius="2"
                                        Background="#1D1610"
                                        BorderBrush="{Binding Accent}"
                                        BorderThickness="2"
                                        Margin="0,0,11,0"
                                        VerticalAlignment="Center">
                                    <Border Width="10" Height="10"
                                            CornerRadius="1"
                                            Background="{Binding Accent}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                </Border>

                                <!-- Name and tagline share a line now, which
                                     is most of where the saved height came
                                     from. -->
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource Ink}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Tagline}"
                                               FontSize="11"
                                               Foreground="{StaticResource Muted}"
                                               VerticalAlignment="Center"
                                               Margin="10,1,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="10,0,10,0">
                                    <Border Style="{StaticResource Chip}">
                                        <TextBlock Text="{Binding MetaText}"
                                                   Style="{StaticResource ChipText}"/>
                                    </Border>
                                    <Border Style="{StaticResource Chip}">
                                        <TextBlock Text="{Binding AccessText}"
                                                   Style="{StaticResource ChipText}"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock Grid.Column="3"
                                           Text="{Binding PlayerText}"
                                           FontFamily="{StaticResource Display}"
                                           FontSize="15"
                                           Foreground="{StaticResource Ink}"
                                           VerticalAlignment="Center"
                                           MinWidth="52"
                                           TextAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border x:Name="DetailPanel"
                        Grid.Column="2"
                        Background="{StaticResource Panel}"
                        BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="3">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="17,16,17,8">
                            <StackPanel>
                                <TextBlock x:Name="DetailName"
                                           Text="No hold selected"
                                           FontFamily="{StaticResource Display}"
                                           FontSize="19"
                                           Foreground="{StaticResource Ink}"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="DetailTagline"
                                           Text="Pick one from the list."
                                           FontSize="11"
                                           Foreground="{StaticResource Muted}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,16"/>

                                <Border Height="1" Background="{StaticResource Line}"
                                        Margin="0,0,0,16"/>

                                <TextBlock Text="ADDRESS" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="DetailAddress" Text="--"
                                           Style="{StaticResource FieldValue}"/>

                                <TextBlock Text="FRAMEWORK" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="DetailRegion" Text="--"
                                           Style="{StaticResource FieldValue}"/>

                                <TextBlock Text="ACCESS" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="DetailAccess" Text="--"
                                           Style="{StaticResource FieldValue}"/>

                                <TextBlock Text="MASTER KEY" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="DetailKey" Text="--"
                                           FontSize="11"
                                           Foreground="{StaticResource Muted}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Join lives in its own footer so it never scrolls
                             out of reach on a short window. -->
                        <Border Grid.Row="1"
                                Background="#221A11"
                                BorderBrush="{StaticResource Line}"
                                BorderThickness="0,1,0,0"
                                Padding="17,14,17,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0 is the original join block, untouched.
                                     The appearance button gets its own row below
                                     rather than sharing the glow, so nothing about
                                     the proven join path moves. -->
                                <Grid Grid.Row="0">
                                <Border CornerRadius="6" Margin="-5" Opacity="0.30">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFB055" Offset="0"/>
                                            <GradientStop Color="#E9701C" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <BlurEffect Radius="20"/>
                                    </Border.Effect>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Border.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0.14" To="0.55"
                                                                     Duration="0:0:2.4"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>

                                <Button x:Name="JoinButton"
                                        Content="Join hold"
                                        Style="{StaticResource Primary}"
                                        Padding="0,12,0,13"
                                        IsEnabled="False"
                                        Click="JoinButton_Click"/>
                                </Grid>

                                <!-- Optional cosmetics. Deliberately quiet: the
                                     mod is fully playable without any of this,
                                     so it must never compete with Join. -->
                                <Button x:Name="AppearanceButton"
                                        Grid.Row="1"
                                        Content="Appearance mods (optional)"
                                        Style="{StaticResource Ghost}"
                                        FontSize="12"
                                        Padding="0,8,0,9"
                                        Margin="0,9,0,0"
                                        Click="AppearanceButton_Click"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ============================================================
             STATUS
             ============================================================ -->
        <Border Grid.Row="3" Padding="22,10,22,12" Margin="0,14,0,0"
                Background="#1A1309"
                BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0">
            <StackPanel>
                <TextBlock x:Name="StatusText"
                           Text="Starting up..."
                           FontSize="11"
                           Foreground="{StaticResource Muted}"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Credits. Not decoration: SSE Engine Fixes is GPL, so the
                     credit is a licence condition, and the IconicDeath
                     werewolf textures are used by the author's written
                     permission. TextWrapping, not trimming, so a narrow
                     window hides none of it. -->
                <TextBlock x:Name="CreditsText"
                           Margin="0,6,0,0"
                           FontSize="10"
                           Opacity="0.75"
                           Foreground="{StaticResource Muted}"
                           TextWrapping="Wrap"
                           Text="Werewolf textures by IconicDeath, used with permission. Built on SkyMP. Includes SSE Engine Fixes by aers, Nukem and Ryan (GPL). SKSE64 is downloaded from skse.silverlock.org, not redistributed. Not affiliated with Bethesda Softworks."/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
