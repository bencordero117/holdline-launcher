<Window x:Class="HoldlineLauncher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Holdline — Settings"
        Height="640" Width="700"
        MinHeight="560" MinWidth="620"
        WindowStartupLocation="CenterOwner"
        Background="#120D08"
        FontFamily="Segoe UI, Inter, Arial"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <!--
        The screen that did not exist, and whose absence cost a tester an
        evening on 2026-07-31.

        Two failures it fixes directly:

          1. The Skyrim folder was picked ONCE and saved forever with no way
             to see or change it. One wrong pick and the launcher was stuck
             on it permanently, with no UI anywhere to undo it.

          2. SKSE had to be dropped into a folder by hand, and the launcher
             happily accepted an ancient wrong-version copy.

        Colours are copied from MainWindow.xaml rather than referenced,
        because this is a separate Window and does not inherit that window's
        resource dictionary.
    -->

    <Window.Resources>
        <SolidColorBrush x:Key="Bg"        Color="#120D08"/>
        <SolidColorBrush x:Key="Panel"     Color="#2A2015"/>
        <SolidColorBrush x:Key="Card"      Color="#251C13"/>
        <SolidColorBrush x:Key="Line"      Color="#4A3A26"/>
        <SolidColorBrush x:Key="LineSoft"  Color="#6B5637"/>
        <SolidColorBrush x:Key="Accent"    Color="#D98A3D"/>
        <SolidColorBrush x:Key="AccentHi"  Color="#E9A057"/>
        <SolidColorBrush x:Key="Ink"       Color="#EDE2C9"/>
        <SolidColorBrush x:Key="Muted"     Color="#B0A08A"/>
        <SolidColorBrush x:Key="Dim"       Color="#8B7B63"/>
        <SolidColorBrush x:Key="Good"      Color="#7FB069"/>
        <SolidColorBrush x:Key="Bad"       Color="#C96A4F"/>

        <FontFamily x:Key="Display">Palatino Linotype, Book Antiqua, Georgia, serif</FontFamily>

        <Style x:Key="Plain" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{StaticResource LineSoft}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Plain}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="#1A1109"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SectionHead" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Display}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Settings"
                   FontFamily="{StaticResource Display}"
                   FontSize="22"
                   Foreground="{StaticResource Ink}"
                   Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ============ one-click repair ============
                     First thing in the window on purpose. A player who has
                     hit a wall should not have to understand the three
                     panels below before anything happens. -->
                <Border Background="{StaticResource Card}"
                        BorderBrush="{StaticResource Accent}"
                        BorderThickness="1" CornerRadius="2"
                        Padding="16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                    Margin="0,0,14,0">
                            <TextBlock Text="Something not working?"
                                       Style="{StaticResource SectionHead}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Style="{StaticResource Note}"
                                       Text="Checks your whole setup and fixes what it can. Safe to run any time — it never deletes anything."/>
                            <TextBlock x:Name="RepairProgressText"
                                       Text=""
                                       FontSize="11"
                                       Foreground="{StaticResource Accent}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                x:Name="FixButton"
                                Content="Fix my game"
                                Style="{StaticResource Primary}"
                                Padding="20,10"
                                FontSize="14"
                                VerticalAlignment="Center"
                                Click="FixButton_Click"/>
                    </Grid>
                </Border>

                <!-- ============ Skyrim folder ============ -->
                <Border Background="{StaticResource Card}"
                        BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="2"
                        Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Where Skyrim is" Style="{StaticResource SectionHead}"/>

                        <Border Background="#1B140D"
                                BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="2"
                                Padding="10,8" Margin="0,0,0,8">
                            <TextBlock x:Name="SkyrimPathText"
                                       Text="(not set)"
                                       FontFamily="Consolas, Courier New, monospace"
                                       FontSize="11"
                                       Foreground="{StaticResource Muted}"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock x:Name="SkyrimStatusText"
                                   Text=""
                                   FontSize="12"
                                   Margin="0,0,0,10"
                                   TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ChangeFolderButton"
                                    Content="Change folder"
                                    Style="{StaticResource Plain}"
                                    Margin="0,0,8,0"
                                    Click="ChangeFolderButton_Click"/>
                            <Button x:Name="DetectButton"
                                    Content="Find it for me"
                                    Style="{StaticResource Plain}"
                                    Margin="0,0,8,0"
                                    Click="DetectButton_Click"/>
                            <Button x:Name="OpenFolderButton"
                                    Content="Open folder"
                                    Style="{StaticResource Plain}"
                                    Click="OpenFolderButton_Click"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource Note}"
                                   Margin="0,10,0,0"
                                   Text="This is the folder containing SkyrimSE.exe. If Holdline ever picked the wrong one, change it here."/>
                    </StackPanel>
                </Border>

                <!-- ============ SKSE ============ -->
                <Border Background="{StaticResource Card}"
                        BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="2"
                        Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="SKSE" Style="{StaticResource SectionHead}"/>

                        <TextBlock x:Name="SkseStatusText"
                                   Text=""
                                   FontSize="12"
                                   Margin="0,0,0,12"
                                   TextWrapping="Wrap"/>

                        <!-- The drop zone. AllowDrop is set here AND the
                             handlers are wired in code-behind; both are
                             required or the drag silently does nothing. -->
                        <Border x:Name="DropZone"
                                Background="#1B140D"
                                BorderBrush="{StaticResource LineSoft}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="18"
                                MinHeight="92"
                                AllowDrop="True"
                                DragOver="DropZone_DragOver"
                                DragLeave="DropZone_DragLeave"
                                Drop="DropZone_Drop">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="DropZoneText"
                                           Text="Drag the SKSE download here"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Ink}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="the .7z file straight from silverlock.org — no need to unzip it"
                                           FontSize="11"
                                           Foreground="{StaticResource Dim}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="GetSkseButton"
                                    Content="Get SKSE"
                                    Style="{StaticResource Primary}"
                                    Margin="0,0,8,0"
                                    Click="GetSkseButton_Click"/>
                            <Button x:Name="ChooseSkseButton"
                                    Content="Choose file..."
                                    Style="{StaticResource Plain}"
                                    Margin="0,0,8,0"
                                    Click="ChooseSkseButton_Click"/>
                            <Button x:Name="ChooseSkseFolderButton"
                                    Content="Choose folder..."
                                    Style="{StaticResource Plain}"
                                    Click="ChooseSkseFolderButton_Click"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource Note}"
                                   Margin="0,10,0,0"
                                   Text="SKSE is made by another team and their rules don't let us include it in Holdline, so you download it once yourself. Holdline puts it in the right place and checks it matches your version of Skyrim."/>
                    </StackPanel>
                </Border>

                <!-- ============ Holdline files ============ -->
                <Border Background="{StaticResource Card}"
                        BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="2"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="Holdline game files" Style="{StaticResource SectionHead}"/>

                        <TextBlock x:Name="ClientStatusText"
                                   Text=""
                                   FontSize="12"
                                   TextWrapping="Wrap"/>

                        <TextBlock Style="{StaticResource Note}"
                                   Margin="0,10,0,0"
                                   Text="These download automatically the first time you join a hold."/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="RecheckButton"
                    Content="Re-check"
                    Style="{StaticResource Plain}"
                    Margin="0,0,8,0"
                    Click="RecheckButton_Click"/>
            <Button x:Name="CloseButton"
                    Content="Close"
                    Style="{StaticResource Primary}"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
